# Wood Carvers Backend Environment Configuration Example
# Copy this file to .env and fill in your credentials

NODE_ENV=development
PORT=5000

# MongoDB Connection String
# Example: mongodb://localhost:27017/woodcarvers OR mongodb+srv://<user>:<password>@cluster.mongodb.net/woodcarvers
MONGODB_URI=mongodb://127.0.0.1:27017/woodcarvers

# JWT Secret for User & Admin Authentication
JWT_SECRET=woodcarvers_super_secure_jwt_secret_change_in_production_982347923
JWT_EXPIRE=7d

# Cloudinary Configuration for Image Storage & Transformations
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Credentials for Payment Integration
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Firebase Cloud Messaging (FCM) Credentials for Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# Frontend Origin for CORS configuration
FRONTEND_URL=http://localhost:3000,http://localhost:8080,http://localhost:5173
